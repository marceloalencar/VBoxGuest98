TARGETNAME=VBoxTray
TARGETPATH=obj
TARGETTYPE=PROGRAM
UMTYPE=windows
UMENTRY=winmain

# The Windows 98 DDK puts its old SDK headers first; the shell tray icon and
# OLE drag and drop need the Visual C++ 6.0 ones.
INCLUDES=..\inc;$(MSVCDIR)\include

SOURCES= \
        VBoxTray.c \
        Mouse.c \
        TimeSync.c \
        Clipboard.c \
        ClipFile.c \
        Stats.c \
        Display.c \
        Seamless.c \
        DnD.c \
        DnDObj.c \
        DnDHgcm.c \
        DnDTransfer.c \
        DnDUtil.c \
        VMInfo.c \
        GuestProp.c \
        GstCtrl.c \
        GstCtrlFile.c \
        AutoMount.c \
        AutoLogon.c \
        Utf.c \
        VbglR3.c \
        VBoxTray.rc

TARGETLIBS= \
        $(MSVCDIR)\lib\ole32.lib \
        $(SDK_LIB_PATH)\shell32.lib \
        $(SDK_LIB_PATH)\user32.lib \
        $(MSVCDIR)\lib\uuid.lib

LIB=$(MSVCDIR)\lib
INCLUDE=$(MSVCDIR)\include

MSC_WARNING_LEVEL=/W3 /WX

USER_C_FLAGS=/MT
C_DEFINES=/DW32
USE_MSVCRT=1
# The Windows 98 DDK has no coffbase.txt to look the base address up in.
UMBASE=0x400000
